{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "lawxygen",
    "main": "./src/worker.mjs",
    "compatibility_date": "2026-08-09",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "build": {
        "command": "node build.js",
        "watch_dir": [
            "views",
            "public",
            "build.js"
        ]
    }
}
