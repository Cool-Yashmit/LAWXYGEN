<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LAWXYGEN</title>

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/navbar') %>


<main>

<section class="lx-hero">

    <div class="lx-hero-light lx-light-one"></div>
    <div class="lx-hero-light lx-light-two"></div>
    <div class="lx-hero-light lx-light-three"></div>

    <div class="lx-hero-grid-bg"></div>

    <div class="lx-hero-container">

        <div class="lx-hero-copy">

            <div class="lx-hero-badge">
                <span></span>
                LAWXYGEN • Breathe Legal Ease
            </div>

            <h1 class="lx-hero-title">
                Business moves fast.
                <span>Your legal work should too.</span>
            </h1>

            <div class="lx-hero-motion-line">
                <span class="lx-motion-label">Built to</span>

                <span class="lx-motion-word-wrap">
                    <span id="lxHeroWord" class="lx-motion-word">
                        Start.
                    </span>
                </span>
            </div>

            <p class="lx-hero-description">
                Business registration, taxation, compliance, intellectual
                property and legal support — brought together in one
                clear digital experience.
            </p>

            <div class="lx-hero-actions">

                <a href="#services" class="lx-hero-primary">
                    <span>Explore Services</span>

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>
                </a>

                <button type="button" class="lx-hero-secondary">
                    Talk to an Expert

                    <span>↗</span>
                </button>

            </div>

            <div class="lx-hero-service-line">

                <span>Business Setup</span>
                <i></i>

                <span>Tax</span>
                <i></i>

                <span>Compliance</span>
                <i></i>

                <span>IP</span>
                <i></i>

                <span>Legal</span>

            </div>

        </div>


        <div class="lx-hero-visual" id="lxHeroVisual">

            <div class="lx-visual-glow"></div>


            <div class="lx-float-card lx-float-company">

                <span class="lx-float-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M4 21V8l8-5 8 5v13"></path>
                        <path d="M9 21v-7h6v7"></path>
                    </svg>
                </span>

                <div>
                    <small>Business</small>
                    <strong>Company Setup</strong>
                </div>

            </div>


            <div class="lx-float-card lx-float-trademark">

                <span class="lx-float-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="12" cy="12" r="8"></circle>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>
                </span>

                <div>
                    <small>Protection</small>
                    <strong>Trademark</strong>
                </div>

            </div>


            <div class="lx-workspace">

                <div class="lx-workspace-top">

                    <div class="lx-workspace-brand">

                        <span class="lx-workspace-mark">
                            L
                        </span>

                        <div>
                            <strong>LAWXYGEN</strong>
                            <small>Legal Workspace</small>
                        </div>

                    </div>

                    <span class="lx-workspace-live">
                        <i></i>
                        Ready
                    </span>

                </div>


                <div class="lx-workspace-heading">

                    <span>Your business needs</span>

                    <h3>
                        Legal clarity,
                        without the complexity.
                    </h3>

                </div>


                <div class="lx-workspace-services">

                    <div class="lx-workspace-service">

                        <span class="lx-service-icon">
                            01
                        </span>

                        <div>
                            <strong>Business Setup</strong>
                            <small>Company, LLP & registrations</small>
                        </div>

                        <span class="lx-service-go">→</span>

                    </div>


                    <div class="lx-workspace-service">

                        <span class="lx-service-icon">
                            02
                        </span>

                        <div>
                            <strong>Tax & Accounting</strong>
                            <small>GST, ITR, TDS & bookkeeping</small>
                        </div>

                        <span class="lx-service-go">→</span>

                    </div>


                    <div class="lx-workspace-service">

                        <span class="lx-service-icon">
                            03
                        </span>

                        <div>
                            <strong>Compliance</strong>
                            <small>ROC & corporate filings</small>
                        </div>

                        <span class="lx-service-go">→</span>

                    </div>

                </div>


                <div class="lx-workspace-bottom">

                    <span>Explore your legal workspace</span>

                    <span>→</span>

                </div>

            </div>


            <div class="lx-float-card lx-float-tax">

                <span class="lx-float-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M6 3h12v18H6z"></path>
                        <path d="M9 8h6"></path>
                        <path d="M9 12h6"></path>
                        <path d="M9 16h3"></path>
                    </svg>
                </span>

                <div>
                    <small>Finance</small>
                    <strong>GST & Tax</strong>
                </div>

            </div>


            <div class="lx-hero-orbit lx-orbit-one"></div>
            <div class="lx-hero-orbit lx-orbit-two"></div>

        </div>

    </div>

</section>

    <section class="law-services" id="services">

    <div class="law-services-wrap">

        <div class="law-services-intro">

            <span class="law-services-label">
                Explore Services
            </span>

            <h2>
                Everything your business
                needs, in one place.
            </h2>

            <p>
                From starting a company to managing tax,
                compliance and legal requirements.
            </p>

            <a href="#" class="law-services-all">
                Browse all services
                <span>↗</span>
            </a>

        </div>


        <div class="law-services-grid">

            <a href="#" class="law-service-card law-service-main">

                <div class="law-card-top">

                    <span class="law-service-number">
                        01
                    </span>

                    <span class="law-service-icon icon-green">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M4 21V8l8-5 8 5v13"></path>
                            <path d="M9 21v-7h6v7"></path>
                        </svg>

                    </span>

                </div>

                <div>

                    <h3>Business Setup</h3>

                    <p>
                        Company registration, LLP,
                        startup setup and business incorporation.
                    </p>

                </div>

                <span class="law-card-arrow">→</span>

            </a>


            <a href="#" class="law-service-card">

                <div class="law-card-top">

                    <span class="law-service-number">
                        02
                    </span>

                    <span class="law-service-icon icon-blue">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M6 3h12v18H6z"></path>
                            <path d="M9 8h6"></path>
                            <path d="M9 12h6"></path>
                            <path d="M9 16h3"></path>
                        </svg>

                    </span>

                </div>

                <div>

                    <h3>Tax & Accounting</h3>

                    <p>
                        GST, income tax, TDS,
                        bookkeeping and accounting.
                    </p>

                </div>

                <span class="law-card-arrow">→</span>

            </a>


            <a href="#" class="law-service-card">

                <div class="law-card-top">

                    <span class="law-service-number">
                        03
                    </span>

                    <span class="law-service-icon icon-purple">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M4 20h16"></path>
                            <path d="M6 17V9"></path>
                            <path d="M10 17V9"></path>
                            <path d="M14 17V9"></path>
                            <path d="M18 17V9"></path>
                            <path d="M3 7l9-4 9 4"></path>
                        </svg>

                    </span>

                </div>

                <div>

                    <h3>Compliance</h3>

                    <p>
                        ROC, labour and ongoing
                        corporate compliance support.
                    </p>

                </div>

                <span class="law-card-arrow">→</span>

            </a>


            <a href="#" class="law-service-card">

                <div class="law-card-top">

                    <span class="law-service-number">
                        04
                    </span>

                    <span class="law-service-icon icon-orange">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="8"></circle>
                            <path d="M9.5 12.5l1.7 1.7 3.5-4"></path>
                        </svg>

                    </span>

                </div>

                <div>

                    <h3>IP & Trademarks</h3>

                    <p>
                        Trademark, copyright,
                        patent and brand protection.
                    </p>

                </div>

                <span class="law-card-arrow">→</span>

            </a>


            <a href="#" class="law-service-card law-service-wide">

                <div class="law-card-top">

                    <span class="law-service-number">
                        05
                    </span>

                    <span class="law-service-icon icon-teal">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M7 3h8l4 4v14H7z"></path>
                            <path d="M15 3v5h5"></path>
                            <path d="M10 13h6"></path>
                            <path d="M10 17h4"></path>
                        </svg>

                    </span>

                </div>

                <div>

                    <h3>Legal Documents & Licenses</h3>

                    <p>
                        Agreements, contracts, business licenses
                        and professional legal assistance.
                    </p>

                </div>

                <span class="law-card-arrow">→</span>

            </a>

        </div>

    </div>

</section>

</main>




    <script src="/js/script.js"></script>

</body>

</html>